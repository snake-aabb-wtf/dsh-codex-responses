{
  "name": "dsh-codex-responses",
  "version": "0.1.5",
  "description": "ChatGPT Codex device authorization and Responses for DeepSeek Harness",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./src/client.cjs",
    "./typert": "./src/typert.mjs"
  },
  "files": ["src", "cordis.patch.yml", "README.md"],
  "engines": { "node": ">=24", "dsh": "0.2.2-rc.3" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-settings-plugins", "@deepseek-ai/dsh-api-remote-access"] }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check src/index.mjs && node --check src/client.cjs && node --check src/typert.mjs && node --check src/oauth-wire.mjs && node --check src/provider.mjs && node --check src/model-catalog.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "zod": "^4.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-authorization": "0.2.2-rc.3",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.2-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.3"
  }
}
